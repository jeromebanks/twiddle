--- /dev/null
+++ b/tests/test_mute_cli.py
@@ -0,0 +1,28 @@
+import argparse
+
+from twiddle import intervention_log, mute_cli, rooms_api
+
+
+def parse(*argv):
+    parser = argparse.ArgumentParser()
+    mute_cli.add_parser(parser.add_subparsers())
+    return parser.parse_args(list(argv))
+
+
+def test_mute_writes_the_room_and_journals_it(monkeypatch):
+    wrote, journal = [], []
+    monkeypatch.setattr(rooms_api, "set_mute", lambda room, muted: wrote.append((room, muted)))
+    monkeypatch.setattr(intervention_log, "record", lambda event, **kw: journal.append((event, kw)))
+    args = parse("mute", "Kitchen")
+    assert args.fn(args) == 0
+    assert wrote == [("Kitchen", True)]
+    assert journal == [("mute", {"room": "Kitchen", "muted": True})]
+
+
+def test_off_unmutes(monkeypatch):
+    wrote = []
+    monkeypatch.setattr(rooms_api, "set_mute", lambda room, muted: wrote.append((room, muted)))
+    monkeypatch.setattr(intervention_log, "record", lambda event, **kw: None)
+    args = parse("mute", "Kitchen", "--off")
+    args.fn(args)
+    assert wrote == [("Kitchen", False)]
