+"""`twiddle mute ROOM [--off]`: mute, or unmute, a room by name."""
+from __future__ import annotations
+
+import argparse
+
+from twiddle import intervention_log, rooms_api
+
+
+def add_parser(sub: argparse._SubParsersAction) -> None:
+    p = sub.add_parser("mute", help="mute or unmute a room")
+    p.add_argument("room", help="the room's name")
+    p.add_argument("--off", action="store_true", help="unmute instead")
+    p.set_defaults(fn=run_mute)
+
+
+def run_mute(args: argparse.Namespace) -> int:
+    muted = not args.off
+    intervention_log.record("mute", room=args.room, muted=muted)
+    rooms_api.set_mute(args.room, muted)
+    print(f"{args.room}: {'muted' if muted else 'unmuted'}")
+    return 0
diff --git a/tests/test_mute_cli.py b/tests/test_mute_cli.py
