{
  "schema": 1,
  "_doc": "What a headless watcher run (`claude -p`) may use: read only from the pinned, pushed commit by tools/sdlc_watch_cmd.py. {PRIMARY} is the primary checkout, {SCRATCH} the run's scratch dir, {N} the issue the run's command names, {WORKTREE} {PRIMARY}/.worktrees/slice-{N}; an `edit` path is absolute once filled, and goes on the command line as `Edit(//<path>)`. A pattern's * matches any text, spaces included, so a push or a label edit is never a wildcard: they are exact, per issue. tests/test_sdlc_watch_cmd.py holds this file to that.",
  "skills": ["triage-issue", "plan-issue", "work-slice", "milestone-demo"],
  "tools": ["Bash", "Read", "Glob", "Grep", "Edit", "Write", "Agent", "Skill"],
  "allow": ["Read", "Glob", "Grep", "Agent"],
  "bash": [
    "uv run python tools/sdlc.py *",
    "uv run python tools/codex_review.py *",
    "uv run python tools/observe.py add *",
    "uv run pytest",
    "uv run pytest *",
    "uv sync",
    "uv sync -q",
    "uv run twiddle status",
    "uv run twiddle status *",
    "uv run twiddle rooms",
    "uv run twiddle alarm list",
    "uv run twiddle alarm status",
    "uv run twiddle limits",
    "git status",
    "git status *",
    "git diff *",
    "git log *",
    "git show *",
    "git rev-parse *",
    "git ls-tree *",
    "git grep *",
    "git fetch",
    "git fetch *",
    "git add *",
    "git commit *",
    "git rebase origin/epic/*",
    "git rebase --continue",
    "git rebase --abort",
    "git merge origin/epic/*",
    "git worktree add *",
    "git worktree remove *",
    "git -C {PRIMARY} pull --ff-only",
    "gh issue view *",
    "gh issue list *",
    "gh pr view *",
    "gh pr list *",
    "gh pr diff *",
    "gh pr checks *",
    "gh pr create *",
    "mkdir -p *",
    "qlmanage -t -s * -o *"
  ],
  "bash_per_issue": [
    "git push -u origin slice/{N}",
    "git push origin slice/{N}",
    "git push --force-with-lease origin slice/{N}",
    "git push -u origin prd/{N}",
    "git push origin prd/{N}",
    "git -C {WORKTREE} fetch *",
    "git -C {WORKTREE} rebase origin/epic/*",
    "git -C {WORKTREE} status",
    "gh issue edit {N} --add-label bug",
    "gh issue edit {N} --add-label enhancement",
    "gh issue edit {N} --add-label complexity:routine",
    "gh issue edit {N} --add-label complexity:judgment",
    "gh issue edit {N} --add-label complexity:novel"
  ],
  "demo_shot": "uv run python {PRIMARY}/tools/demo_shot.py cli *",
  "edit": ["{PRIMARY}/.worktrees/**", "{SCRATCH}/**"]
}
